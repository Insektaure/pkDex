<brls:Box
    width="auto"
    height="auto"
    axis="column"
    alignItems="stretch"
    paddingTop="20px"
    paddingBottom="50px"
    paddingLeft="50px"
    paddingRight="75px" >

    <brls:Box
        width="auto"
        height="auto"
        axis="row"
        alignItems="flexStart"
        marginBottom="20px">

        <!-- Left side: Images stacked vertically -->
        <brls:Box
            width="30%"
            height="auto"
            axis="column"
            alignItems="center"
            marginRight="20px">

            <!-- Normal image (top) -->
            <brls:Box
                width="auto"
                height="50%"
                axis="column"
                alignItems="center">
                <brls:Label
                    id="standard_label"
                    width="auto"
                    height="auto"
                    text="Standard"
                    fontSize="20"
                    marginBottom="5px"
                />
                <brls:Image
                    id="standard_image"
                    width="180px"
                    height="180px"
                    grow="1"
                    image="@res/img/placeholder_256.png"/>
            </brls:Box>

            <!-- Shiny image (bottom) -->
            <brls:Box
                width="auto"
                height="50%"
                axis="column"
                alignItems="center">
                <brls:Label
                    id="shiny_label"
                    width="auto"
                    height="auto"
                    text="Shiny"
                    fontSize="20"
                    marginBottom="5px"/>
                <brls:Image
                    id="shiny_image"
                    width="180px"
                    height="180px"
                    grow="1"
                    image="@res/img/placeholder_256.png"/>
            </brls:Box>
        </brls:Box>

        <!-- Right side: Pokemon information -->
        <brls:Box
            id="info_box"
            width="70%"
            height="auto"
            axis="column"
            marginLeft="-20px">

            <!-- Row 1: National Number and Regional number as separate boxes -->
            <brls:Box
                    width="auto"
                    height="auto"
                    axis="row"
                    marginBottom="1px">

                <!-- National Number Box Title -->
                <brls:Box
                        alignItems="center"
                        width="33%"
                        height="auto"
                        axis="column">

                    <!-- Title centered -->
                    <brls:Box
                            width="100%"
                            height="auto"
                            justifyContent="center"
                            backgroundColor="#507C36"
                            paddingTop="5px"
                            paddingBottom="5px">
                        <brls:Label
                                width="100%"
                                height="auto"
                                horizontalAlign="center"
                                text="@i18n/pkdex/view/infos/title/national_number"
                                fontSize="20"/>
                    </brls:Box>
                </brls:Box>

                <!-- Regional Number Box Title -->
                <brls:Box
                        alignItems="center"
                        width="33%"
                        height="auto"
                        axis="column"
                        marginLeft="5px">

                    <!-- Title centered -->
                    <brls:Box
                            width="100%"
                            height="auto"
                            justifyContent="center"
                            backgroundColor="#507C36"
                            paddingTop="5px"
                            paddingBottom="5px">
                        <brls:Label
                                width="100%"
                                height="auto"
                                horizontalAlign="center"
                                text="@i18n/pkdex/view/infos/title/regional_number"
                                fontSize="20"/>
                    </brls:Box>
                </brls:Box>

                <!-- Shiny Lock Box Title -->
                <brls:Box
                        alignItems="center"
                        width="33%"
                        height="auto"
                        axis="column"
                        marginLeft="5px">

                    <!-- Title centered -->
                    <brls:Box
                            width="100%"
                            height="auto"
                            justifyContent="center"
                            backgroundColor="#507C36"
                            paddingTop="5px"
                            paddingBottom="5px">
                        <brls:Label
                                width="100%"
                                height="auto"
                                horizontalAlign="center"
                                text="@i18n/pkdex/view/infos/title/shiny"
                                fontSize="20"/>
                    </brls:Box>
                </brls:Box>
            </brls:Box>

            <brls:Box
                width="auto"
                height="auto"
                axis="row"
                marginBottom="15px">

                <!-- National Number Box Content -->
                <brls:Box
                    alignItems="center"
                    width="33%"
                    height="auto"
                    axis="column"
                    backgroundColor="#404040"
                    borderColor="#AAAAAA"
                    borderThickness="0px">

                    <!-- Content -->
                    <brls:Box
                        width="auto"
                        height="auto"
                        padding="10px">
                        <brls:Label
                            id="national_dex"
                            width="auto"
                            height="auto"
                            fontSize="24"
                            horizontalAlign="center"/>
                    </brls:Box>
                </brls:Box>

                <!-- Regional Number Box Content -->
                <brls:Box
                    alignItems="center"
                    width="33%"
                    height="auto"
                    axis="column"
                    marginLeft="5px"
                    backgroundColor="#404040"
                    borderColor="#AAAAAA"
                    borderThickness="0px">

                    <!-- Content -->
                    <brls:Box
                        width="auto"
                        height="auto"
                        padding="10px">
                        <brls:Label
                            id="regional_dex"
                            width="auto"
                            height="auto"
                            fontSize="24"
                            horizontalAlign="center"/>
                    </brls:Box>
                </brls:Box>

                <!-- Shiny Lock Box Content -->
                <brls:Box
                        alignItems="center"
                        width="33%"
                        height="auto"
                        axis="column"
                        marginLeft="5px"
                        backgroundColor="#404040"
                        borderColor="#AAAAAA"
                        borderThickness="0px">

                    <!-- Content -->
                    <brls:Box
                            width="auto"
                            height="auto"
                            padding="10px">
                        <brls:Label
                                id="shiny_locked"
                                width="auto"
                                height="auto"
                                fontSize="24"
                                horizontalAlign="center"/>
                    </brls:Box>
                </brls:Box>
            </brls:Box>

            <!-- Row 2: Type and exclusive version as separate boxes -->
            <brls:Box
                width="auto"
                height="auto"
                axis="row"
                marginBottom="1px">

                <!-- Type Box Title -->
                <brls:Box
                    alignItems="center"
                    width="50%"
                    height="auto"
                    axis="column">

                    <!-- Title centered -->
                    <brls:Box
                        width="100%"
                        height="auto"
                        justifyContent="center"
                        backgroundColor="#507C36"
                        paddingTop="5px"
                        paddingBottom="5px">
                        <brls:Label
                            width="100%"
                            height="auto"
                            horizontalAlign="center"
                            text="@i18n/pkdex/view/infos/title/type"
                            fontSize="20"/>
                    </brls:Box>

                </brls:Box>

                <!-- Exclusive Version Box Title -->
                <brls:Box
                    alignItems="center"
                    width="49%"
                    height="auto"
                    axis="column"
                    marginLeft="10px">

                    <!-- Title centered -->
                    <brls:Box
                        width="100%"
                        height="auto"
                        justifyContent="center"
                        backgroundColor="#507C36"
                        paddingTop="5px"
                        paddingBottom="5px">
                        <brls:Label
                            width="100%"
                            height="auto"
                            horizontalAlign="center"
                            text="@i18n/pkdex/view/infos/title/version"
                            fontSize="20"/>
                    </brls:Box>
                </brls:Box>
            </brls:Box>

            <brls:Box
                    width="auto"
                    height="auto"
                    axis="row"
                    marginBottom="15px">

                <!-- Type Box Content-->
                <brls:Box
                        alignItems="center"
                        width="50%"
                        height="auto"
                        axis="column"
                        backgroundColor="#404040"
                        borderColor="#AAAAAA"
                        borderThickness="0px">

                    <!-- Content -->
                    <brls:Box
                            width="auto"
                            height="auto"
                            padding="10px">
                        <brls:Label
                                id="type"
                                width="auto"
                                height="auto"
                                fontSize="24"
                                horizontalAlign="center"/>
                    </brls:Box>
                </brls:Box>

                <!-- Exclusive Version Box Content -->
                <brls:Box
                        alignItems="center"
                        width="49%"
                        height="auto"
                        axis="column"
                        marginLeft="10px"
                        backgroundColor="#404040"
                        borderColor="#AAAAAA"
                        borderThickness="0px">

                    <!-- Content -->
                    <brls:Box
                            width="auto"
                            height="auto"
                            padding="10px">
                        <brls:Label
                                id="exclusive_version"
                                width="auto"
                                height="auto"
                                fontSize="24"
                                horizontalAlign="center"/>
                    </brls:Box>
                </brls:Box>
            </brls:Box>

            <!-- Row 3: Evolution -->
            <brls:Box
                    alignItems="center"
                    width="100%"
                    height="auto"
                    axis="column"
                    marginBottom="1px">

                <!-- Title centered -->
                <brls:Box
                        width="100%"
                        height="auto"
                        justifyContent="center"
                        backgroundColor="#507C36"
                        paddingTop="5px"
                        paddingBottom="5px">
                    <brls:Label
                            width="auto"
                            height="auto"
                            text="@i18n/pkdex/view/infos/title/evolution"
                            fontSize="20"/>
                </brls:Box>

            </brls:Box>

            <brls:Box
                alignItems="center"
                width="100%"
                height="auto"
                axis="column"
                marginBottom="15px"
                backgroundColor="#404040"
                borderColor="#AAAAAA"
                borderThickness="0px">

                <!-- Content -->
                <brls:Box
                    width="auto"
                    height="auto"
                    padding="10px">
                    <brls:Label
                        id="evolution"
                        width="auto"
                        height="auto"
                        fontSize="18"/>
                </brls:Box>
            </brls:Box>

            <!-- Row 4: Locations -->
            <brls:Box
                    width="100%"
                    height="auto"
                    axis="column"
                    marginBottom="1px">

                <!-- Title centered -->
                <brls:Box
                        width="100%"
                        height="auto"
                        justifyContent="center"
                        backgroundColor="#507C36"
                        paddingTop="5px"
                        paddingBottom="5px">
                    <brls:Label
                            width="auto"
                            height="auto"
                            text="@i18n/pkdex/view/infos/title/locations"
                            fontSize="20"/>
                </brls:Box>
            </brls:Box>

            <brls:Box
                width="100%"
                height="auto"
                axis="column"
                marginBottom="15px"
                backgroundColor="#404040"
                borderColor="#AAAAAA"
                borderThickness="0px">

                <!-- Content -->
                <brls:Box
                    width="auto"
                    height="auto"
                    padding="10px">
                    <brls:Label
                        id="locations"
                        width="auto"
                        height="auto"
                        fontSize="18"/>
                </brls:Box>
            </brls:Box>
        </brls:Box>
    </brls:Box>

    <brls:Box
        width="100%"
        height="auto"
        axis="row"
        justifyContent="flexEnd">
        <brls:Button
            id="close_button"
            width="auto"
            height="auto"
            text="@i18n/hints/back"
            marginTop="24px"/>
    </brls:Box>

</brls:Box>
