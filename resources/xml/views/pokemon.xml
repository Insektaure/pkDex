<brls:Box
    width="auto"
    height="auto"
    axis="column"
    alignItems="center"
    paddingTop="50px"
    paddingBottom="50px"
    paddingLeft="50px"
    paddingRight="75px" >

    <brls:Box
        width="auto"
        height="auto"
        axis="row"
        alignItems="center"
        marginBottom="20px">

        <!-- Left side: Images stacked vertically -->
        <brls:Box
            width="40%"
            height="auto"
            axis="column"
            alignItems="center"
            marginRight="20px">

            <!-- Normal image (top) -->
            <brls:Box
                width="auto"
                height="50%"
                axis="column"
                alignItems="center">
                <brls:Label
                    id="standard_label"
                    width="auto"
                    height="auto"
                    text="Standard"
                    fontSize="20"
                    marginBottom="5px"/>
                <brls:Image
                    id="standard_image"
                    width="auto"
                    height="auto"
                    grow="1"
                    image="@res/img/placeholder_256.png"/>
            </brls:Box>

            <!-- Shiny image (bottom) -->
            <brls:Box
                width="auto"
                height="50%"
                axis="column"
                alignItems="center">
                <brls:Label
                    id="shiny_label"
                    width="auto"
                    height="auto"
                    text="Shiny"
                    fontSize="20"
                    marginBottom="5px"/>
                <brls:Image
                    id="shiny_image"
                    width="auto"
                    height="auto"
                    grow="1"
                    image="@res/img/placeholder_256.png"/>
            </brls:Box>
        </brls:Box>

        <!-- Right side: Pokemon information -->
        <brls:Box
            width="60%"
            height="auto"
            axis="column">

        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            marginBottom="10px">
            <brls:Label
                width="40%"
                height="auto"
                text="National N° :"
                fontSize="18"/>
            <brls:Label
                id="national_dex"
                width="60%"
                height="auto"
                fontSize="18"/>
        </brls:Box>

        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            marginBottom="10px">
            <brls:Label
                width="40%"
                height="auto"
                text="Regional N° :"
                fontSize="18"/>
            <brls:Label
                id="regional_dex"
                width="60%"
                height="auto"
                fontSize="18"/>
        </brls:Box>

        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            marginBottom="10px">
            <brls:Label
                width="40%"
                height="auto"
                text="Type :"
                fontSize="18"/>
            <brls:Label
                id="type"
                width="60%"
                height="auto"
                fontSize="18"/>
        </brls:Box>

        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            marginBottom="10px">
            <brls:Label
                width="40%"
                height="auto"
                text="Evolution :"
                fontSize="18"/>
            <brls:Label
                id="evolution"
                width="60%"
                height="auto"
                fontSize="18"/>
        </brls:Box>

        <brls:Box
                width="auto"
                height="auto"
                axis="row"
                marginBottom="10px">
            <brls:Label
                    width="40%"
                    height="auto"
                    text="Exclusive Version :"
                    fontSize="18"/>
            <brls:Label
                    id="exclusive_version"
                    width="60%"
                    height="auto"
                    fontSize="18"/>
        </brls:Box>

        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            marginBottom="10px">
            <brls:Label
                width="40%"
                height="auto"
                text="Locations :"
                fontSize="18"/>
            <brls:Label
                id="locations"
                width="60%"
                height="auto"
                fontSize="18"/>
        </brls:Box>
    </brls:Box>
    </brls:Box>

    <brls:Button
            id="close_button"
            width="auto"
            height="auto"
            text="@i18n/hints/back"
            marginTop="24px"/>

</brls:Box>