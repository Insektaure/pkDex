<brls:Box
    width="auto"
    height="auto"
    focusable="true"
    paddingTop="12.5"
    paddingBottom="12.5">

    <brls:Rectangle
        id="selectIndicator"
        width="4px"
        height="44px"
        visibility="gone"
        marginLeft="4px"
        marginRight="4px"/>

    <brls:Image
        id="image"
        width="44px"
        height="44px"
        marginLeft="@style/brls/sidebar/item_accent_margin_sides"
        marginRight="@style/brls/sidebar/item_accent_margin_sides"/>

    <brls:Label
        id="title"
        width="auto"
        height="auto"
        grow="1.0"
        fontSize="@style/brls/sidebar/item_font_size"
        marginTop="@style/brls/sidebar/item_accent_margin_top_bottom"
        marginBottom="@style/brls/sidebar/item_accent_margin_top_bottom"
        marginLeft="@style/brls/sidebar/item_accent_margin_sides"
        marginRight="@style/brls/sidebar/item_accent_margin_sides" />


    <brls:Image
        id="rightIcon"
        width="44px"
        height="44px"
        marginRight="4px"/>
    <brls:Image
        id="rightIcon2"
        width="44px"
        height="44px"
        marginRight="4px"/>
    <brls:Image
        id="rightIcon3"
        width="44px"
        height="44px"
        marginRight="4px"/>
    <brls:Image
        id="rightIcon4"
        width="44px"
        height="44px"
        marginRight="16px"/>

</brls:Box>
